{
	"modName": "Compass Navigation Overhaul VR",
	"displayName": "Compass Navigation Overhaul VR",
	"customContent": {
		"source": "MCM/Compass Navigation Overhaul VR/splashart.swf"
	},
	"pages": [
		{
			"pageDisplayName": "Compass",
			"cursorFillMode": "topToBottom",
			"content": [
				{
					"text": "Markers ",
					"type": "header"
				},
				{
					"id": "uUndiscoveredLocationMarkers:Display",
					"text": "Undiscovered Locations",
					"help": "Select how undiscovered map markers are displayed.\nDefault: Hidden",
					"type": "stepper",
					"valueOptions": {
						"options": [ "Hidden", "\"?\" Marker", "Normal Marker" ],
						"sourceType": "ModSettingInt"
					}
				},
				{
					"id": "bShowEnemyMarkers:Display",
					"text": "Show Enemies",
					"help": "Default: Enabled",
					"type": "toggle",
					"valueOptions": {
						"sourceType": "ModSettingBool"
					}
				},
				{
					"id": "bShowInteriorMarkers:Display",
					"text": "Show through Portals",
					"help": "Shows location and enemies through portals, for example cities, from the outside.\nDefault: Enabled",
					"type": "toggle",
					"valueOptions": {
						"sourceType": "ModSettingBool"
					}
				},
				{
					"text": "Control ",
					"type": "header"
				},
				{
					"id": "fAngleToShowMarkerDetails:Display",
					"text": "Start Cone of Vision",
					"help": "Angle to the compass center to start showing marker details.\nDefault: 10º",
					"type": "slider",
					"valueOptions": {
						"min": 1,
						"max": 90,
						"step": 1,
						"formatString": "{0} º",
						"sourceType": "ModSettingFloat"
					}
				},
				{
					"id": "fAngleToKeepMarkerDetailsShown:Display",
					"text": "Stop Cone of Vision",
					"help": "Angle to the compass center to stop showing marker details once shown.\nDefault: 35º",
					"type": "slider",
					"valueOptions": {
						"min": 1,
						"max": 90,
						"step": 1,
						"formatString": "{0} º",
						"sourceType": "ModSettingFloat"
					}
				},
				{
					"id": "fFocusingDelayToShow:Display",
					"text": "Cone of Vision Delay",
					"help": "Delay to show the centered marker details.\nDefault: 0.1 s",
					"type": "slider",
					"valueOptions": {
						"min": 0.05,
						"max": 3.0,
						"step": 0.05,
						"formatString": "{2} s",
						"sourceType": "ModSettingFloat"
					}
				},
				{
					"text": "Markers Extra Info",
					"type": "header",
					"position": 1
				},
				{
					"id": "bShowUndiscoveredLocationInfo:Display",
					"text": "Show Undiscovered Location Info",
					"help": "Hide/show distance and name for undiscovered location markers.\nDefault: Disabled",
					"type": "toggle",
					"valueOptions": {
						"sourceType": "ModSettingBool"
					}
				},
				{
					"id": "bShowEnemyNameUnderMarker:Display",
					"text": "Show Enemy Names",
					"help": "Show enemy name under the compass enemy marker when not in direct combat.\nDefault: Enabled",
					"type": "toggle",
					"valueOptions": {
						"sourceType": "ModSettingBool"
					}
				},
				{
					"id": "bUseMetricUnits:Display",
					"text": "Units",
					"help": "Use metric or imperial units.\nDefault: Metric",
					"type": "stepper",
					"valueOptions": {
						"options": [ "Imperial", "Metric" ],
						"sourceType": "ModSettingBool"
					}
				},
				{
					"id": "bShowObjectiveAsTarget:Display",
					"text": "Quest Info Displayed",
					"help": "Changes the text under the compass quest marker to show the location or the objective.\nDefault: Objective",
					"type": "stepper",
					"valueOptions": {
						"options": [ "Location", "Objective" ],
						"sourceType": "ModSettingBool"
					}
				},
				{
					"id": "bShowOtherObjectivesCount:Display",
					"text": "Show Additional Objectives Count",
					"help": "Adds the number of objectives to the text under the compass quest marker.\nDefault: Enabled",
					"type": "toggle",
					"valueOptions": {
						"sourceType": "ModSettingBool"
					}
				},
				{
					"id": "fMarkerNameScale:Display",
					"text": "Quest/Location Name Size",
					"help": "Text size of the quest/location name under the compass marker, in percent.\nDefault: 100%",
					"type": "slider",
					"valueOptions": {
						"min": 25,
						"max": 150,
						"step": 5,
						"formatString": "{0} %",
						"sourceType": "ModSettingFloat"
					}
				},
				{
					"id": "fMarkerDistanceScale:Display",
					"text": "Distance Size",
					"help": "Size of the distance readout and above/below indicator, in percent.\nDefault: 100%",
					"type": "slider",
					"valueOptions": {
						"min": 25,
						"max": 150,
						"step": 5,
						"formatString": "{0} %",
						"sourceType": "ModSettingFloat"
					}
				}
			]
		},
		{
			"pageDisplayName": "Quest List",
			"cursorFillMode": "topToBottom",
			"content": [
				{
					"text": "Display ",
					"type": "header",
					"position": 0
				},
				{
					"id": "fOffsetX:QuestList",
					"text": "X Offset",
					"help": "Horizontal offset from the compass text anchor, in HUD coordinates. Positive moves right; negative moves left. Still follows the compass.\nDefault: 0",
					"type": "slider",
					"valueOptions": {
						"min": -100,
						"max": 100,
						"step": 5,
						"formatString": "{0}",
						"sourceType": "ModSettingFloat"
					}
				},
				{
					"id": "fOffsetY:QuestList",
					"text": "Y Offset",
					"help": "Vertical offset from the compass text anchor, in HUD coordinates. Positive moves down; negative moves up. Available height is automatic.\nDefault: 0",
					"type": "slider",
					"valueOptions": {
						"min": -100,
						"max": 100,
						"step": 5,
						"formatString": "{0}",
						"sourceType": "ModSettingFloat"
					}
				},
				{
					"id": "fTextScale:QuestList",
					"text": "Panel Size",
					"help": "Overall size of the quest list panel, in percent. Entries, text and icons scale together.\nDefault: 100%",
					"type": "slider",
					"valueOptions": {
						"min": 25,
						"max": 110,
						"step": 5,
						"formatString": "{0} %",
						"sourceType": "ModSettingFloat"
					}
				},
				{
					"id": "bShowInExteriors:QuestList",
					"text": "Show in Exteriors",
					"help": "Show the quest list in exteriors.\nDefault: Enabled",
					"type": "toggle",
					"valueOptions": {
						"sourceType": "ModSettingBool"
					}
				},
				{
					"id": "bShowInInteriors:QuestList",
					"text": "Show in Interiors",
					"help": "Show the quest list in interiors.\nDefault: Enabled",
					"type": "toggle",
					"valueOptions": {
						"sourceType": "ModSettingBool"
					}
				},
				{
					"id": "bHideInCombat:QuestList",
					"text": "Hide In Combat",
					"help": "Hide when the weapon is drawn.\nDefault: Disabled",
					"type": "toggle",
					"valueOptions": {
						"sourceType": "ModSettingBool"
					}
				},
				{
					"text": "Compass Gaze ",
					"type": "header",
					"position": 1
				},
				{
					"id": "bRequireLookingAtCompass:QuestList",
					"text": "Require Looking at Compass",
					"help": "Only show the quest list while your 3D gaze rests on the compass. A focused quest marker is still required.\nDefault: Enabled",
					"type": "toggle",
					"valueOptions": {
						"sourceType": "ModSettingBool"
					}
				},
				{
					"id": "bRequireCompassVisible:QuestList",
					"text": "Require Compass Visible",
					"help": "Hide the quest list while the compass itself is hidden (e.g. Palm Compass VR with the palm down).\nDefault: Enabled",
					"type": "toggle",
					"valueOptions": {
						"sourceType": "ModSettingBool"
					}
				},
				{
					"id": "uCompassGazeMode:QuestList",
					"text": "Gaze Detection Mode",
					"help": "How gaze is measured. Higher modes fall back automatically when their 3D node is missing.\nDefault: Compass Node",
					"type": "stepper",
					"valueOptions": {
						"options": [ "Pitch Fallback", "Right Hand", "Compass Node" ],
						"sourceType": "ModSettingInt"
					}
				},
				{
					"id": "fCompassGazeAngleToShow:QuestList",
					"text": "Gaze Angle to Show",
					"help": "3D gaze angle to the compass or hand point that starts showing the list (modes 1-2).\nDefault: 15º",
					"type": "slider",
					"valueOptions": {
						"min": 1,
						"max": 90,
						"step": 1,
						"formatString": "{0} º",
						"sourceType": "ModSettingFloat"
					}
				},
				{
					"id": "fCompassGazeAngleToKeep:QuestList",
					"text": "Gaze Angle to Keep",
					"help": "Once shown, the list hides only after this angle is exceeded (modes 1-2).\nDefault: 25º",
					"type": "slider",
					"valueOptions": {
						"min": 1,
						"max": 90,
						"step": 1,
						"formatString": "{0} º",
						"sourceType": "ModSettingFloat"
					}
				},
				{
					"id": "fCompassMaxDistance:QuestList",
					"text": "Max Gaze Distance",
					"help": "Gaze points farther than this are ignored. In game units, about 70 per meter.\nDefault: 90",
					"type": "slider",
					"valueOptions": {
						"min": 20,
						"max": 300,
						"step": 5,
						"formatString": "{0}",
						"sourceType": "ModSettingFloat"
					}
				},
				{
					"id": "fCompassGazePitchToShow:QuestList",
					"text": "Pitch Angle to Show",
					"help": "How far down you must look to show the list in Pitch mode (mode 0).\nDefault: 18º",
					"type": "slider",
					"valueOptions": {
						"min": 0,
						"max": 90,
						"step": 1,
						"formatString": "{0} º",
						"sourceType": "ModSettingFloat"
					}
				},
				{
					"id": "fCompassGazePitchToKeep:QuestList",
					"text": "Pitch Angle to Keep",
					"help": "Once shown in Pitch mode, the list hides only after you look up past this angle.\nDefault: 10º",
					"type": "slider",
					"valueOptions": {
						"min": 0,
						"max": 90,
						"step": 1,
						"formatString": "{0} º",
						"sourceType": "ModSettingFloat"
					}
				},
				{
					"id": "bCompassOnPalm:QuestList",
					"text": "Compass on Palm",
					"help": "Enable for Palm Compass VR: look DOWN at your palm. Disable if the compass floats above eye level: look UP instead.\nDefault: Enabled",
					"type": "toggle",
					"valueOptions": {
						"sourceType": "ModSettingBool"
					}
				}
			]
		},
		{
			"pageDisplayName": "Debug",
			"cursorFillMode": "topToBottom",
			"content": [
				{
					"id": "uLogLevel:Debug",
					"text": "Log Level",
					"help": "Trace and Debug enable all HUD diagnostic outlines, short status text and detailed logs. Info and higher disable the HUD diagnostics. Boundary calibration remains separate.\nDefault: Info",
					"type": "stepper",
					"valueOptions": {
						"options": [ "Trace", "Debug", "Info", "Warning", "Error", "Critical Error" ],
						"sourceType": "ModSettingInt"
					}
				}
			]
		}
	]
}
